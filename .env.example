# --- S3/MinIO Configuration ---
AWS_S3_ENDPOINT=https://minio.apps.cluster.example.com
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_DEFAULT_REGION=us-east-1
# Set to "false" to skip TLS certificate verification (e.g. self-signed certs)
S3_VERIFY_TLS=true

# --- Milvus Configuration ---
MILVUS_HOST=milvus.apps.cluster.example.com
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_SECURE=false

# --- Pipeline Artifacts S3 Configuration ---
# Separate S3 connection for pipeline artifacts (evaluation results, notebooks, etc.)
ARTIFACTS_AWS_S3_ENDPOINT=https://artifacts-minio.apps.cluster.example.com
ARTIFACTS_AWS_ACCESS_KEY_ID=your-artifacts-access-key
ARTIFACTS_AWS_SECRET_ACCESS_KEY=your-artifacts-secret-key
# Default bucket for artifacts (used when KFP run config lacks a full s3:// URI)
ARTIFACTS_S3_BUCKET=your-artifacts-bucket
ARTIFACTS_AWS_DEFAULT_REGION=us-east-1
# Set to "false" to skip TLS certificate verification (e.g. self-signed certs)
ARTIFACTS_S3_VERIFY_TLS=true

# --- KFP Pipelines Configuration ---
RHOAI_KFP_URL=https://ds-pipeline-dspa.apps.cluster.example.com/
RHOAI_TOKEN=sha256~your-openshift-token
RHOAI_PROJECT_NAME=your-namespace
# Set to "false" to skip TLS certificate verification
KFP_VERIFY_SSL=true
# Optional: override auto-derived K8S API URL (for logs command)
# K8S_API_URL=https://api.cluster.example.com:6443
# K8S_API_PORT=6443

# --- Kubernetes Secrets Configuration ---
# Uses RHOAI_TOKEN from KFP section above for authentication.
# K8S API URL: uses K8S_API_URL if set, otherwise derived from RHOAI_KFP_URL.
# Target namespace: uses RHOAI_PROJECT_NAME, overridable with --namespace flag.

# --- pgvector Configuration ---
PGVECTOR_HOST=pgvector.apps.cluster.example.com
PGVECTOR_PORT=5432
PGVECTOR_DATABASE=vectordb
PGVECTOR_USER=
PGVECTOR_PASSWORD=
# SSL mode: disable, allow, prefer, require, verify-ca, verify-full
PGVECTOR_SSLMODE=prefer

# --- OGX Configuration ---
OGX_CLIENT_BASE_URL=https://ogx.apps.cluster.example.com
OGX_CLIENT_API_KEY=
